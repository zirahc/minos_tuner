# Tuner + scoring on one VPS. Copy to .env. Do not paste real keys into chat.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=

# Path to the minos_subnet checkout that has main.py and datasets/practice
# MINOS_SUBNET=/home/you/minos_subnet

# SUPABASE_SCORE_VIEW=gatk_config_scores
# OPTUNA_STORAGE=sqlite:///optuna.db

# Agent (optional). If unset, python -m tuner.agent uses heuristic rules.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
