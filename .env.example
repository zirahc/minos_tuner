# GATK checkout. download_practice_samples.py writes datasets/practice and
# datasets/reference under this path. score_gatk_folders.py reads the same tree.
MINOS_SUBNET=/root/minos_subnet

# 24/7 fleet. Tuner: python -m tuner.fleet
# Each GATK VPS uses a different WORKER_ID, then: python main.py
# WORKER_ID=1
# TUNER_WORKERS=1,2,3,4
# First screen size. The top quarter then scores the next N different rounds.
# FLEET_ROUNDS=3
# Trials placed on the stack before the agent runs again.
# Free VPS take the next one. The agent waits until the last one finishes.
# FLEET_BATCH=8

# SUPABASE_SCORE_VIEW=gatk_config_scores
# OPTUNA_STORAGE=sqlite:///optuna.db

# Agent review (optional). Without a key the multi-step agent still runs.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
