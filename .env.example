SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpdGFnc2Zlamt1dWV2Y2Fnbml6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTk2MzU4MCwiZXhwIjoyMTA1NTM5NTgwfQ._Z_Ct9kG5JXiMWbcW300UZWdKG7RRCC2a5jiqDlhnak

# GATK checkout. download_practice_samples.py writes datasets/practice and
# datasets/reference under this path. score_gatk_folders.py reads the same tree.
MINOS_SUBNET=/root/minos_subnet

# Hugging Face repo id (owner/name). A dataset or a model repo.
# eliteminer/minos_ch19 is a model. download_huggingface.py reads this.
# A folder passed on the command line, or --repo, overrides it for that run.
HF_DATASET=eliteminer/minos_ch19
# Read token. Leave empty when the repo is public.
HF_TOKEN=

# 24/7 fleet. Tuner: python -m tuner.fleet
# Each GATK VPS uses a different WORKER_ID, then: python main.py
# main.py posts that id to gatk_workers. The fleet assigns work to whoever
# is online, so a new machine does not need a fleet restart.
# WORKER_ID=1
# Each trial scores every practice round in the folder.
# Trials placed on the stack before the agent runs again.
# Free VPS take the next one. The agent waits until the last one finishes.
# FLEET_BATCH=8

# SUPABASE_SCORE_VIEW=gatk_config_scores
# OPTUNA_STORAGE=sqlite:///optuna.db

# AGENT=false queues only the experiments table. true (the default) runs the agent after those.
# AGENT=false

# Leave empty to run every experiments row that is not done.
# Set one experiments.id to run only that row.
# EXPERIMENT_ID=

# Agent review (optional). Without a key the multi-step agent still runs.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
